{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "start",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "pagina",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "http-server",
        "marketing",
        "-p",
        "4321",
        "-c-1"
      ],
      "port": 4321
    },
    {
      "name": "sin-nube",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set EXPO_PUBLIC_SUPABASE_URL=https://sin-nube.invalid&& set EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=x&& npx expo start --clear"
      ],
      "port": 8081
    }
  ]
}
